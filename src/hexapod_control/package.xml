<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hexapod_control</name>
  <version>0.1.0</version>
  <description>Gait engine node, calibration, teleop, and bring-up helpers</description>
  <maintainer email="you@example.com">you</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>hexapod_msgs</exec_depend>
  <exec_depend>hexapod_kinematics</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>sts3215_driver</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
